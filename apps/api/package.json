{
  "name": "@lb/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup src/server.ts --format esm --target node22 --noExternal @lb --out-dir dist",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@lb/content": "workspace:*",
    "@lb/contracts": "workspace:*",
    "@lb/db": "workspace:*",
    "@lb/engine": "workspace:*",
    "@sentry/node": "^11.13.0",
    "hono": "^4.13.19",
    "jose": "^6.2.17",
    "zod": "^4.3.2"
  },
  "devDependencies": {
    "@lb/config": "workspace:*",
    "@types/node": "^22.18.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  }
}
