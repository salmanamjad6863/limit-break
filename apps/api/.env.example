# ── Server ────────────────────────────────────────────────────────────────
PORT=8787

# ── Database (Supabase → Connect → ORMs / Connection string) ─────────────
# Transaction pooler, port 6543: used by the API at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1"

# ── Supabase project ─────────────────────────────────────────────────────
# Project Settings → API (or Data API): Project URL
SUPABASE_URL="https://<project-ref>.supabase.co"
# Project Settings → API Keys → Secret key (sb_secret_…) or legacy service_role.
# SERVER ONLY, never in the app. Needed for account deletion and trial-video uploads.
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional / later ─────────────────────────────────────────────────────
USDA_API_KEY=
# comma-separated web origins allowed by CORS (empty = any, fine for dev)
ALLOWED_ORIGINS=
# comma-separated user ids who moderate: A/S trial videos and the community queue
MODERATOR_IDS=
SENTRY_DSN=
# keep false until subscriptions launch (everything unlocked)
PAYWALL_ENABLED=false

# ── Community moderation (optional) ──────────────────────────────────────
# Claude Haiku 5.5 classifies posts/comments before they're shown (console.anthropic.com → API keys).
# Unset: wordlist only, and posts from new accounts wait for a moderator.
ANTHROPIC_API_KEY=
# Extra blocked words/phrases, comma-separated (e.g. from a maintained slur list)
COMMUNITY_WORDLIST=
