# ── Supabase (Project Settings → API Keys) ───────────────────────────────
# Safe to ship in the app: the publishable key only allows what the API and RLS allow.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<publishable key sb_publishable_… (or legacy anon key)>

# Digits in the email sign-in code (Supabase → Auth → Providers → Email → OTP length). Default 6.
EXPO_PUBLIC_OTP_LENGTH=6

# ── API ──────────────────────────────────────────────────────────────────
# Local: http://localhost:8787 (simulator). Real phone on Wi-Fi: http://<your-mac-LAN-IP>:8787
# Production: your Railway URL
EXPO_PUBLIC_API_URL=http://localhost:8787

# ── Optional / later ─────────────────────────────────────────────────────
EXPO_PUBLIC_MEDIA_BASE_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
