# Supabase → Project Settings → API (publishable / anon key — safe to ship in the app)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<publishable-or-anon-key>
# Hono API (apps/api). On a physical device use your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8787
# Exercise demo media CDN (Supabase Storage public bucket URL). Leave empty until clips exist.
EXPO_PUBLIC_MEDIA_BASE_URL=
