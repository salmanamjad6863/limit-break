    { "id": "lower-b", "name": "Lower B · Squat Skills", "focus": "lower", "slots": [
      { "pattern": "squat", "role": "main", "sets": 4, "reps": [3, 8], "rir": 2, "prefer": ["pistol-squat", "bulgarian-split-squat"], "fallback": ["lunge"] },
      { "pattern": "lunge", "role": "secondary", "sets": 3, "reps": [8, 12], "rir": 2, "prefer": ["step-up", "walking-lunge"] },
      { "pattern": "plyo", "role": "accessory", "sets": 3, "reps": [5, 8], "rir": 3, "prefer": ["jump-squat"], "optional": true },
      { "pattern": "calf", "role": "accessory", "sets": 3, "reps": [12, 20], "rir": 1 },
      { "pattern": "core_anti_rotation", "role": "core", "sets": 3, "reps": [8, 12], "rir": 2, "prefer": ["bird-dog", "pallof-press"] }
