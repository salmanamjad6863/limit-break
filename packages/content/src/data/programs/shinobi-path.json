      { "pattern": "vertical_pull", "role": "main", "sets": 4, "reps": [5, 10], "rir": 2, "prefer": ["chin-up", "band-assisted-pull-up", "negative-pull-up"], "fallback": ["horizontal_pull"] },
      { "pattern": "horizontal_push", "role": "secondary", "sets": 3, "reps": [6, 10], "rir": 2, "prefer": ["archer-push-up", "diamond-push-up", "push-up"] },
      { "pattern": "horizontal_pull", "fallback": ["rear_delt"], "role": "secondary", "sets": 3, "reps": [8, 12], "rir": 2, "prefer": ["inverted-row", "doorframe-row"] },
      { "pattern": "core_anti_lateral", "role": "core", "sets": 3, "seconds": [20, 40], "rir": 2, "prefer": ["side-plank"] }
