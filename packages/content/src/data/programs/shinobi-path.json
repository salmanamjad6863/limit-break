      { "pattern": "hinge", "role": "secondary", "sets": 3, "reps": [8, 12], "rir": 2, "prefer": ["single-leg-rdl"] },
      { "pattern": "hip_thrust", "role": "accessory", "sets": 3, "reps": [10, 15], "rir": 1, "prefer": ["single-leg-glute-bridge"] },
      { "pattern": "calf", "role": "accessory", "sets": 3, "reps": [12, 20], "rir": 1 },
      { "pattern": "core_flexion", "role": "core", "sets": 3, "reps": [8, 12], "rir": 2, "prefer": ["hanging-knee-raise"], "fallback": ["core_anti_extension"] }
    ]},
    { "id": "upper-b", "name": "Upper B · Push Focus", "focus": "upper", "slots": [
