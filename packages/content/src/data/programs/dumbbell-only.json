{
  "id": "dumbbell-only",
  "name": "Dumbbell Only",
  "typeId": "hypertrophy",
  "summary": "Three full-body days with just a pair of dumbbells (and a bench if you have one). Bodyweight swaps fill any gaps.",
  "levels": [
    "beginner",
    "novice",
    "intermediate"
  ],
  "locations": [
    "HOME",
    "HYBRID"
  ],
  "goals": [
    "recomp",
    "maintain",
    "cut",
    "bulk"
  ],
  "daysPerWeek": [
    3
  ],
  "blockWeeks": 6,
  "deloadEvery": 6,
  "days": [
    {
      "id": "full-a",
      "name": "Full Body A",
      "focus": "full",
      "slots": [
        {
          "pattern": "squat",
          "role": "main",
          "sets": 3,
          "rir": 2,
          "reps": [
            8,
            12
          ],
          "prefer": [
            "goblet-squat"
          ]
        },
        {
          "pattern": "horizontal_push",
          "role": "main",
          "sets": 3,
          "rir": 2,
          "reps": [
            8,
            12
          ],
          "prefer": [
            "db-bench-press",
            "db-floor-press"
          ]
        },
        {
          "pattern": "horizontal_pull",
          "role": "secondary",
          "sets": 3,
          "rir": 2,
          "reps": [
            8,
            12
          ],
          "prefer": [
            "db-row"
          ]
        },
        {
          "pattern": "hinge",
          "role": "secondary",
          "sets": 3,
          "rir": 2,
          "reps": [
            8,
            12
          ],
          "prefer": [
            "db-romanian-deadlift"
          ]
        },
        {
          "pattern": "shoulder_abduction",
          "role": "accessory",
          "sets": 2,
          "rir": 1,
          "reps": [
            12,
            20
          ],
          "prefer": [
            "db-lateral-raise"
          ],
          "optional": true
        },
        {
          "pattern": "core_anti_extension",
          "role": "core",
          "sets": 2,
          "rir": 2,
          "reps": [
            8,
            12
          ],
          "prefer": [
            "dead-bug"
          ]
        }
      ]
    },
    {
