// LIMITBREAK schema v1 — Sprint 0. Spec: ARCHITECTURE.md §8, SYSTEMS.md.
// Schema changes ONLY via `pnpm db:migrate`. Never edit tables in the Supabase dashboard.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rank {
  E
  D
  C
  B
  A
  S
  SOVEREIGN
}

enum HeroClass {
  HYBRID
  FIGHTER
  ASSASSIN
  JUGGERNAUT
  RANGER
  MONK
}

enum TrainingLocation {
  HOME
  GYM
  HYBRID
}

enum QuestKind {
  DAILY
  MAIN
  SIDE
  BOSS
  TRIAL
  EVENT
  HIDDEN
  PENALTY
}

enum QuestStatus {
  ACTIVE
  COMPLETED
  FAILED
  EXPIRED
}

/// id = auth.users.id. Row is created by the on_auth_user_created trigger; onboarding fills the rest.
model Profile {
  id                 String            @id @db.Uuid
  hunterName         String?
  heroId             String?
  heroClass          HeroClass?
  sex                String?
  birthDate          DateTime?         @db.Date
  heightCm           Float?
  goal               String?
  experience         String?
  location           TrainingLocation?
  equipment          String[]          @default([])
  injuries           String[]          @default([])
  lifestyle          String?
  nutritionMode      String            @default("full")
  fatPreference      String            @default("balanced")
  /// nutrition settings (SYSTEMS.md §2.10)
  ratePerWeek        Float             @default(0)
  checkInDay         Int               @default(1)
  hideCalories       Boolean           @default(false)
  proteinOverrideG   Float?
  fatOverrideG       Float?
  daysPerWeek        Int?
  /// picked training weekdays, 0 = Sunday (SYSTEMS.md §3.10)
  trainingWeekdays   Int[]             @default([])
  workoutTime        String?
  sessionMinutes     Int?
  questTime          String?
  timezone           String            @default("UTC")
  /// Awakening Assessment results — Daily Quest scaling baselines (SYSTEMS.md §4.6)
  baselines          Json?
  notificationsOptIn Boolean           @default(false)
  /// chosen program + when it was picked (rotation restarts on change) — restored on a new phone
  activeProgramId    String?
  programStartedAt   DateTime?
  /// exercises flagged "this hurts" in the player; the generator swaps them out
  avoidExercises     String[]          @default([])
  /// explicit health-data consent (GDPR Art. 9): policy version shown + when
  consentVersion     String?
  consentedAt        DateTime?
  onboardedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  state             HunterState?
  events            Event[]
  workouts          WorkoutSession[]
  records           PersonalRecord[]
  quests            QuestInstance[]
  foodLogs          FoodLog[]
  bodyMetrics       BodyMetric[]
  progressPhotos    ProgressPhoto[]
  mealTemplates     MealTemplate[]
  weeklyDebriefs    WeeklyDebrief[]
  tdee              TdeeEstimate[]
  targets           NutritionTarget[]
  entitlements      Entitlement[]
  pushTokens        PushToken[]
  trials            TrialAttempt[]
  exerciseNotes     ExerciseNote[]
  publicProfile     PublicProfile?
  posts             Post[]
  comments          Comment[]
  reactions         Reaction[]
  following         Follow[]           @relation("follower")
  followers         Follow[]           @relation("followee")
  blocking          Block[]            @relation("blocker")
  blockedBy         Block[]            @relation("blocked")
  reports           Report[]
  followRequestsOut FollowRequest[]    @relation("followReqFrom")
  followRequestsIn  FollowRequest[]    @relation("followReqTo")
  guildMemberships  GuildMember[]
  guildMessages     GuildMessage[]
  guildsLed         Guild[]            @relation("guildLeader")
  duelsChallenged   Duel[]             @relation("duelChallenger")
  duelsOpposed      Duel[]             @relation("duelOpponent")
  raidParts         RaidContribution[]
  leagueParts       LeagueMember[]
  conversationsA    Conversation[]     @relation("convoA")
  conversationsB    Conversation[]     @relation("convoB")
  messages          Message[]
  friendStreaksA    FriendStreak[]     @relation("streakA")
  friendStreaksB    FriendStreak[]     @relation("streakB")
  shieldsGiven      FriendShieldGift[] @relation("shieldGiver")
  shieldsReceived   FriendShieldGift[] @relation("shieldReceiver")
  essenceLedger     EssenceLedger[]
  cosmeticsOwned    CosmeticOwned[]
  avatarLoadout     AvatarLoadout?
}

model HunterState {
  userId           String   @id @db.Uuid
  level            Int      @default(1)
  xp               Int      @default(0)
  rank             Rank     @default(E)
  apUnspent        Int      @default(0)
  /// highest level AP was ever paid for (no re-grants after edit-down / delete + re-finish)
  apGrantedLevel   Int      @default(1)
  streak           Int      @default(0)
  longest          Int      @default(0)
  shields          Int      @default(2)
  /// SYSTEMS.md §4.5–4.6 streak + quest scaling state
  questScale       Float    @default(0.6)
  consecutiveFails Int      @default(0)
  shieldsMonth     String?
  penaltyDate      String?
  lastResolved     String?
  sickDates        String[] @default([])
  str              Float    @default(10)
  agi              Float    @default(10)
  end              Float    @default(10)
  vit              Float    @default(10)
  spi              Float    @default(10)
  /// Avatar Forge cosmetic currency (VISUALS.md §7). Never buys XP/stats/rank.
  essence          Int      @default(0)
  updatedAt        DateTime @updatedAt
  profile          Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Append-only source of truth. id is client-generated = idempotency key.
model Event {
  id        String     @id @db.Uuid
  userId    String     @db.Uuid
  type      String
  payload   Json
  localDate String
  clientTs  DateTime
  serverTs  DateTime   @default(now())
  flagged   Boolean    @default(false)
  xp        XpLedger[]
  profile   Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, serverTs])
  @@index([userId, localDate])
}

/// Written by the server reward calculator only.
model XpLedger {
  id        Int      @id @default(autoincrement())
  eventId   String   @db.Uuid
  userId    String   @db.Uuid
  localDate String
  amount    Int
  reason    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, localDate])
  @@index([localDate, userId])
}

model Exercise {
  id         String         @id
  name       String
  pattern    String
  equipment  String[]
  primary    String[]
  secondary  String[]
  difficulty Int
  bwFactor   Float          @default(0)
  restType   String
  mediaKey   String?
  linksFrom  ExerciseLink[] @relation("from")
  linksTo    ExerciseLink[] @relation("to")
}

model ExerciseLink {
  fromId String
  toId   String
  kind   String // SUBSTITUTE | PROGRESSION | REGRESSION
  from   Exercise @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  to     Exercise @relation("to", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId, kind])
}

model WorkoutSession {
  id               String       @id @db.Uuid
  userId           String       @db.Uuid
  plannedWorkoutId String?
  localDate        String
  startedAt        DateTime
  finishedAt       DateTime?
  plannedHardSets  Int          @default(0)
  /// interval / cardio minutes (quick sessions) — feeds the Shadow-Self boss
  cardioMinutes    Float        @default(0)
  /// cardio entries as finished ([{ minutes, rpe }]) so edits recompute XP exactly like finish; null on older rows
  cardio           Json?
  /// program | quick | manual (SYSTEMS.md §3.11)
  kind             String       @default("program")
  /// app = logged live; manual = logged afterwards (unverified: no leaderboards)
  source           String       @default("app")
  name             String?
  notes            String?
  programId        String?
  dayId            String?
  sessionRpe       Float?
  /// XP currently credited for this workout (edits adjust it by a diff)
  xpGranted        Int          @default(0)
  editedAt         DateTime?
  sets             WorkoutSet[]
  profile          Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, localDate])
  @@index([localDate, userId])
}

model WorkoutSet {
  id          String         @id @db.Uuid
  sessionId   String         @db.Uuid
  exerciseId  String
  order       Int
  reps        Int?
  weightKg    Float?
  rir         Int?
  rpe         Float?
  durationS   Int?
  distanceM   Float?
  isWarmup    Boolean        @default(false)
  /// normal | drop | failure
  setType     String         @default("normal")
  completedAt DateTime
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model PersonalRecord {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  exerciseId String
  e1rmKg     Float
  setId      String   @db.Uuid
  confirmed  Boolean  @default(true)
  achievedAt DateTime
  profile    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId, achievedAt])
}

model QuestInstance {
  id          String      @id @db.Uuid
  userId      String      @db.Uuid
  templateId  String
  kind        QuestKind
  localDate   String
  targets     Json
  progress    Json        @default("{}")
  status      QuestStatus @default(ACTIVE)
  dueAt       DateTime
  completedAt DateTime?
  profile     Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate, templateId])
  @@index([userId, status, dueAt])
  @@index([kind, status, localDate])
}

model Food {
  id       String    @id
  source   String // curated | usda | off | fatsecret | user
  sourceId String?
  name     String
  brand    String?
  barcode  String?   @unique
  kcal100  Float
  p100     Float
  c100     Float
  f100     Float
  alc100   Float     @default(0)
  fiber100 Float?
  density  Float?
  servings Json      @default("[]")
  verified Boolean   @default(false)
  ownerId  String?   @db.Uuid // user-created foods stay private
  logs     FoodLog[]

  @@index([name])
}

model FoodLog {
  id           String   @id @db.Uuid
  userId       String   @db.Uuid
  foodId       String
  grams        Float
  meal         String
  servingLabel String?
  localDate    String
  loggedAt     DateTime
  food         Food     @relation(fields: [foodId], references: [id])
  profile      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, localDate])
}

model NutritionDay {
  userId         String   @db.Uuid
  localDate      String
  markedComplete Boolean  @default(false)
  lowDayConfirm  Boolean  @default(false)
  waterMl        Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@id([userId, localDate])
}

model BodyMetric {
  id         String   @id @db.Uuid
  userId     String   @db.Uuid
  localDate  String
  measuredAt DateTime
  weightKg   Float?
  bodyFatPct Float?
  waistCm    Float?
  neckCm     Float?
  hipCm      Float?
  chestCm    Float?
  armCm      Float?
  source     String   @default("manual")
  profile    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, localDate])
}

model TdeeEstimate {
  userId     String  @db.Uuid
  localDate  String
  trendKg    Float?
  tdee       Float
  observed   Float?
  confidence Float
  profile    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, localDate])
}

model NutritionTarget {
  id            String  @id @default(uuid()) @db.Uuid
  userId        String  @db.Uuid
  effectiveFrom String
  kcal          Float
  proteinG      Float
  fatG          Float
  carbsG        Float
  fiberG        Float
  goal          String
  ratePerWeek   Float
  profile       Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveFrom])
}

/// SYSTEMS.md §7.1 — premium access, whatever its source.
model Entitlement {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  key       String // "premium"
  source    String // dev | revenuecat | promo | founder
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  profile   Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, source])
}

model PushToken {
  token     String   @id
  userId    String   @db.Uuid
  platform  String
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// SYSTEMS.md §4.4 — every Rank Trial attempt (pass or fail), for cooldowns, history and verification.
model TrialAttempt {
  id           String    @id @db.Uuid
  userId       String    @db.Uuid
  targetRank   Rank
  setting      String
  results      Json
  events       Json
  composite    Float
  passed       Boolean
  verified     Boolean   @default(false)
  /// none | required | pending | verified | rejected (A/S leaderboard eligibility, SYSTEMS.md §4.4)
  verification String    @default("none")
  videoKey     String?
  submittedAt  DateTime?
  reviewerId   String?   @db.Uuid
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  profile      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([verification, submittedAt])
}

/// Sticky per-exercise note ("seat 4", "use the EZ bar"), shown next time (SYSTEMS.md §3.11).
model ExerciseNote {
  userId     String   @db.Uuid
  exerciseId String
  note       String
  updatedAt  DateTime @updatedAt
  profile    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId])
}

/// ───────────── Community (SYSTEMS.md §5) ─────────────
/// The public face of a hunter: a handle (never the real name). No row = not in the community yet.
model PublicProfile {
  userId    String   @id @db.Uuid
  /// lowercase, 3–20 chars [a-z0-9_.], unique
  handle    String   @unique
  isPublic  Boolean  @default(true)
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  followerId String   @db.Uuid
  followeeId String   @db.Uuid
  createdAt  DateTime @default(now())
  follower   Profile  @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   Profile  @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId])
}

/// milestone (auto: rank-up, PR, level, streak, program) | progress (written by the hunter)
model Post {
  id           String      @id @db.Uuid
  authorId     String      @db.Uuid
  type         String
  body         String?
  /// milestone details or an attached workout card
  payload      Json?
  /// public | followers | private
  visibility   String
  /// pending (moderation) | visible | hidden (by moderator) | removed (by author)
  status       String
  /// all | followers | off
  commentsMode String      @default("all")
  respectCount Int         @default(0)
  commentCount Int         @default(0)
  /// rank of the author when posted (the "My rank" tab)
  authorRank   String      @default("E")
  createdAt    DateTime    @default(now())
  comments     Comment[]
  reactions    Reaction[]
  media        PostMedia[]
  author       Profile     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([authorId, createdAt, id])
  @@index([visibility, status, authorRank, createdAt, id])
}

/// photo attachments on progress posts (SYSTEMS.md §5.2); status pending until image moderation
model PostMedia {
  id         String   @id @db.Uuid
  postId     String   @db.Uuid
  storageKey String
  width      Int
  height     Int
  /// pending | visible | rejected
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Comment {
  id        String   @id @db.Uuid
  postId    String   @db.Uuid
  authorId  String   @db.Uuid
  parentId  String?  @db.Uuid
  body      String
  /// pending | visible | hidden | removed
  status    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
}

/// one sticker per hunter per post; every sticker counts as Respect
model Reaction {
  postId    String   @db.Uuid
  userId    String   @db.Uuid
  sticker   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

/// mutual invisibility
model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())
  blocker   Profile  @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   Profile  @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id         String    @id @db.Uuid
  reporterId String    @db.Uuid
  /// post | comment | profile
  targetType String
  targetId   String
  reason     String
  details    String?
  /// open | upheld | dismissed
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?   @db.Uuid
  reporter   Profile   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId, status])
  @@index([status, resolvedAt])
}

/// audit log of every moderation decision (automatic or human)
model ModerationAction {
  id         String   @id @db.Uuid
  targetType String
  targetId   String
  /// auto_hold | auto_allow | approve | hide | dismiss_report | uphold_report
  action     String
  reason     String
  /// null = the automatic classifier
  actorId    String?  @db.Uuid
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

/**
 * ---------------- Sprint 10: friends, guilds, raids, leagues, DMs (SYSTEMS.md §5.6) ----------------
 */

/// private-profile follow request (accepted → Follow row)
model FollowRequest {
  fromId    String   @db.Uuid
  toId      String   @db.Uuid
  createdAt DateTime @default(now())
  from      Profile  @relation("followReqFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        Profile  @relation("followReqTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
  @@index([toId, createdAt])
}

/// mutual-follow shared Daily Quest streak
model FriendStreak {
  userA        String   @db.Uuid
  userB        String   @db.Uuid
  current      Int      @default(0)
  longest      Int      @default(0)
  lastBothDate String?
  updatedAt    DateTime @updatedAt
  a            Profile  @relation("streakA", fields: [userA], references: [id], onDelete: Cascade)
  b            Profile  @relation("streakB", fields: [userB], references: [id], onDelete: Cascade)

  @@id([userA, userB])
  @@index([userB])
}

/// one Streak Shield gift per friend per calendar month
model FriendShieldGift {
  giverId    String   @db.Uuid
  receiverId String   @db.Uuid
  /// YYYY-MM
  month      String
  createdAt  DateTime @default(now())
  giver      Profile  @relation("shieldGiver", fields: [giverId], references: [id], onDelete: Cascade)
  receiver   Profile  @relation("shieldReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@id([giverId, receiverId, month])
  @@index([receiverId, month])
}

model Duel {
  id                 String    @id @db.Uuid
  challengerId       String    @db.Uuid
  opponentId         String    @db.Uuid
  /// pending | active | completed | declined | cancelled
  status             String
  startsAt           DateTime
  endsAt             DateTime
  challengerXp       Int       @default(0)
  opponentXp         Int       @default(0)
  challengerBaseline Int
  opponentBaseline   Int
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  challenger         Profile   @relation("duelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent           Profile   @relation("duelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  @@index([challengerId, status])
  @@index([opponentId, status])
  @@index([challengerId, createdAt])
  @@index([opponentId, createdAt])
}

model Guild {
  id        String         @id @db.Uuid
  name      String
  /// short join code (uppercase)
  code      String         @unique
  isPublic  Boolean        @default(true)
  language  String?
  timezone  String         @default("UTC")
  leaderId  String         @db.Uuid
  createdAt DateTime       @default(now())
  leader    Profile        @relation("guildLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members   GuildMember[]
  messages  GuildMessage[]
  raids     Raid[]

  @@index([isPublic, createdAt])
  @@index([isPublic, language, createdAt])
}

model GuildMember {
  guildId  String   @db.Uuid
  userId   String   @db.Uuid
  /// leader | officer | member
  role     String
  joinedAt DateTime @default(now())
  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  @@unique([userId])
  @@index([guildId])
}

model GuildMessage {
  id        String   @id @db.Uuid
  guildId   String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  /// pending | visible | hidden
  status    String
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  author    Profile  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([authorId, createdAt])
}

model Raid {
  id          String             @id @db.Uuid
  guildId     String             @db.Uuid
  /// Monday game-date of the raid week (YYYY-MM-DD)
  weekStart   String
  bossHp      Int
  damageTotal Int                @default(0)
  clearedAt   DateTime?
  createdAt   DateTime           @default(now())
  guild       Guild              @relation(fields: [guildId], references: [id], onDelete: Cascade)
  parts       RaidContribution[]

  @@unique([guildId, weekStart])
  @@index([weekStart])
}

model RaidContribution {
  raidId     String  @db.Uuid
  userId     String  @db.Uuid
  xp         Int     @default(0)
  expectedXp Int
  raid       Raid    @relation(fields: [raidId], references: [id], onDelete: Cascade)
  user       Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([raidId, userId])
}

model LeagueGroup {
  id        String         @id @db.Uuid
  weekStart String
  /// Bronze … Mythic
  tier      String
  /// bucket index within the tier for that week
  index     Int
  /// set once the week is over and every member's final `place` is written
  settledAt DateTime?
  members   LeagueMember[]

  @@unique([weekStart, tier, index])
  @@index([weekStart, tier])
}

model LeagueMember {
  groupId String      @db.Uuid
  userId  String      @db.Uuid
  xp      Int         @default(0)
  place   Int?
  group   LeagueGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@unique([userId, groupId])
  @@index([userId])
}

/// DM thread between two mutual follows (both 18+)
model Conversation {
  id        String    @id @db.Uuid
  userA     String    @db.Uuid
  userB     String    @db.Uuid
  /// open | request
  status    String    @default("open")
  /// when userA / userB last opened the thread (unread = peer messages after this)
  readAtA   DateTime?
  readAtB   DateTime?
  /// newest message time: orders the inbox without scanning messages
  lastMessageAt DateTime?
  createdAt DateTime  @default(now())
  a         Profile   @relation("convoA", fields: [userA], references: [id], onDelete: Cascade)
  b         Profile   @relation("convoB", fields: [userB], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([userA, userB])
  @@index([userA, lastMessageAt])
  @@index([userB, lastMessageAt])
}

model Message {
  id             String       @id @db.Uuid
  conversationId String       @db.Uuid
  senderId       String       @db.Uuid
  body           String
  /// pending | visible | hidden
  status         String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

/// Private progress photos (SYSTEMS.md §6). Storage bucket `progress-photos` is PRIVATE; never shown in community payloads.
model ProgressPhoto {
  id         String   @id @db.Uuid
  userId     String   @db.Uuid
  localDate  String
  takenAt    DateTime
  /// before | after | progress
  kind       String
  /// progress/{userId}/{id}.jpg
  storageKey String
  width      Int
  height     Int
  note       String?
  createdAt  DateTime @default(now())
  profile    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, localDate])
}

model MealTemplate {
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  name      String
  /// breakfast | lunch | dinner | snack | other
  meal      String
  /// [{ foodId, grams, servingLabel? }]
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Private weekly recap written in the System's voice. weekStart = Monday (YYYY-MM-DD).
model WeeklyDebrief {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  weekStart String
  body      String
  metrics   Json
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

/// Avatar Forge Essence ledger (docs/AVATAR.md). amount may be negative for spends. Idempotent on (eventId, reason).
model EssenceLedger {
  id        Int      @id @default(autoincrement())
  eventId   String   @db.Uuid
  userId    String   @db.Uuid
  localDate String
  amount    Int
  reason    String
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, reason])
  @@index([userId, localDate])
}

model CosmeticOwned {
  userId     String   @db.Uuid
  cosmeticId String
  acquiredAt DateTime @default(now())
  profile    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, cosmeticId])
  @@index([userId])
}

/// Equipped cosmetic ids per slot (null = none / default).
model AvatarLoadout {
  userId    String  @id @db.Uuid
  body      String?
  hair      String?
  outfit    String?
  accessory String?
  aura      String?
  prop      String?
  frame     String?
  updatedAt DateTime @updatedAt
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
}
